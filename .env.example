# 只填写你需要使用的平台；无需全部申请。密钥留在本地。
# fal.ai：FASHN 试衣 + Kling Pro/Standard 动作迁移
FAL_KEY=

# 火山方舟：Seedream 图片编辑换装（可选模型ID覆盖）
ARK_API_KEY=
SEEDREAM_MODEL=

# 火山即梦：动作模仿
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# TOS：即梦动作必需；Liblib 默认原生上传，仅 tos 回退时需要
TOS_BUCKET=
TOS_ENDPOINT=
TOS_REGION=
# 不填时复用上面的火山 AK/SK
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
# 可选；默认6小时有效期、fashion-dance目录前缀
TOS_URL_TTL_SECONDS=
TOS_PREFIX=

# LiblibAPI：双密钥 + 工作流 API JSON 配置文件路径
LIBLIB_ACCESS_KEY=
LIBLIB_SECRET_KEY=
LIBLIB_TRYON_CONFIG=
LIBLIB_MOTION_CONFIG=
# 默认使用 Liblib 原生视频上传；可设为 tos 并填写上面的 TOS 配置
LIBLIB_VIDEO_UPLOAD=native
# MiniMax H3 official pay-as-you-go key (not M Plan)
MINIMAX_API_KEY=
# MiniMax Speech reuses MINIMAX_API_KEY; speech access/billing is separate.
# Whole-film sound effects (optional; local audio imports need no key)
ELEVENLABS_API_KEY=
